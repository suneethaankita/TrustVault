# TrustVault Environment Configuration Template
# Copy this file to .env for local overrides or configure in your deployment dashboard (e.g. Render)

# Application Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# JSON Web Token Secret Key (Must be at least 32 characters in production)
JWT_SECRET=trustvault-super-secure-production-jwt-key-2026-snovasys

# Zero-Trust File Storage Master Encryption Key (Used for AES-256-GCM encryption at rest)
VAULT_ENCRYPTION_KEY=trustvault-master-zero-trust-key-2026-snovasys

# Database File Path (Defaults to ./trustvault.db)
DB_PATH=./trustvault.db
